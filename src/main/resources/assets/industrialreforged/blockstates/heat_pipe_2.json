{
  "multipart": [
    {
      "apply": {
        "model": "industrialreforged:block/heat/pipe_core_2"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "industrialreforged:block/heat/pipe_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "industrialreforged:block/heat/pipe_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "industrialreforged:block/heat/pipe_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "industrialreforged:block/heat/pipe_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "industrialreforged:block/heat/pipe_arm_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "industrialreforged:block/heat/pipe_arm_up",
        "x": 180
      }
    }
  ]
}
